<div class="container-show" data-controller="visibility">
  <div class="navigation">
    <p> scéance <%= @position_in_cycle %>/5 </p>
    <button data-action="click->visibility#next">
      next
    </button>
  </div>

  <div class="exercice">

  <% @exercices.each do |exercice| %>
    <div class="exercice-card hidden" data-visibility-target="image" >
      <div class="card-content">

        <div class="picture">
          <%= image_tag exercice.image %>
        </div>
      </div>
    </div>
  <% end %>

  </div>
</div>
